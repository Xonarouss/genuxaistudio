{
  "name": "genux-desktop-app",
  "version": "1.0.0",
  "description": "Genux AI Desktop Workstation (100% Local RTX 5080 Video Recasting Engine)",
  "main": "main.js",
  "author": "Xonarous Inc (https://xonarous.nl)",
  "scripts": {
    "build:studio": "powershell -Command \"cd '../web-portal'; npx vite build --config vite.config.studio.ts; Copy-Item -Path '../desktop-app/dist-ui/desktop-studio.html' -Destination '../desktop-app/dist-ui/index.html' -Force\"",
    "start": "electron .",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "nl.xonarous.genux",
    "productName": "Genux AI",
    "asar": false,
    "copyright": "Copyright © 2026 Xonarous Inc (https://xonarous.nl)",
    "directories": {
      "output": "dist-package"
    },
    "win": {
      "target": [
        "dir",
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Genux AI Studio",
      "artifactName": "Genux_AI_Setup_${version}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-ui/**/*",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin"
      }
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
